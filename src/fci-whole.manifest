<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded in the game and editor executables (tools/compile.py). UTF-8 as the process's code page: the
     command line, the folders it names and every "A" Windows call are UTF-8, so the game and save folders
     may hold any character (the runtime reads them as UTF-8). Windows 10 1903 and later. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
