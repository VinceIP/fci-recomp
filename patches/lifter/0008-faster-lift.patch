+        """Get the raw bytes for a section.
+
+        Cached: the probes ask for a section once per candidate address, and
+        slicing a copy of a multi-megabyte .text each time cost more than all
+        the decoding they do.
+        """
+        key = (section.raw_addr, section.raw_size)
+        cache = self.__dict__.setdefault("_section_data", {})
