 }
 
+/* One fixed time (FILETIME) reported for every game-disc file, in place of the host file's time;
+ * zero turns it off. Why: research/docs/internals.md (Disk and saves). */
+static ULONGLONG s_disc_time = 0;
+
+void xbox_SetDiscTime(ULONGLONG filetime)
+{
+    s_disc_time = filetime;
+}
+
+static void disc_stamp_fields(LARGE_INTEGER* creation)
+{
+    LONGLONG t = (LONGLONG)s_disc_time;
+    creation[0].QuadPart = t;
+    creation[1].QuadPart = t;
+    creation[2].QuadPart = t;
+    creation[3].QuadPart = t;
+}
+
+static void disc_stamp(LARGE_INTEGER* creation, const xbox_host_char* host_path)
+{
+    if (s_disc_time && host_path && xbox_host_path_is_disc(host_path))
+        disc_stamp_fields(creation);
+}
+
