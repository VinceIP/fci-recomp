@@ -664,4 +679,17 @@ translate:
     }
 }
 
+int xbox_host_path_is_disc(const xbox_host_char* host_path)
+{
+    if (!host_path)
+        return 0;
+    if (host_path[0] == '\\' && host_path[1] == '\\' && host_path[2] == '?' && host_path[3] == '\\')
+        host_path += 4;
+    size_t len = strlen(s_game_dir);
+    if (!len)
+        return 0;
+    return strncmp(host_path, s_game_dir, len) == 0 &&
+           (host_path[len] == '/' || host_path[len] == '\\');
+}
