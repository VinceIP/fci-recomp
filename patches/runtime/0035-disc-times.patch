+int xbox_host_path_is_disc(const xbox_host_char* host_path)
+{
+    if (!host_path)
+        return 0;
+    /* GetFinalPathNameByHandleW yields the \\?\ extended-length form; s_game_dir is plain. */
+    if (host_path[0] == L'\\' && host_path[1] == L'\\' && host_path[2] == L'?' && host_path[3] == L'\\')
+        host_path += 4;
+    size_t len = wcslen(s_game_dir);
+    if (!len)
+        return 0;
+    /* s_game_dir has no trailing separator (xbox_path_init strips it). */
+    return _wcsnicmp(host_path, s_game_dir, len) == 0 &&
+           (host_path[len] == L'\\' || host_path[len] == L'/');
+}
