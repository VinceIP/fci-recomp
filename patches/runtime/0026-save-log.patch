+++ b/src/kernel/savelog.c
@@ -0,0 +1,98 @@
+/*
+ * savelog.c - UDATA path filter and save log line format. See savelog.h.
+ */
+
+#include "savelog.h"
+#include <stdio.h>
+#include <string.h>
+
+static int udata_at(const char* s)
+{
+    static const char seg[5] = "UDATA";
+    int i;
+    for (i = 0; i < 5; i++) {
+        char c = s[i];
+        if (c >= 'a' && c <= 'z')
+            c = (char)(c + 'A' - 'a');
+        if (c != seg[i])
+            return 0;
+    }
+    return 1;
+}
+
+/* The part of an Xbox path below the UDATA (save) partition, or NULL.
+ *
+ * Two spellings of the same partition reach the kernel, and a title may use
+ * either, so both must be recognised or the log goes quiet on half the files
+ * a save touches:
+ *   U:\rest                                   the U: drive letter
+ *   \Device\Harddisk0\PartitionN\UDATA\rest   the device path
+ * The match is case-insensitive; an object-manager "\??" prefix is
+ * transparent. */
+const char* savelog_udata_rel(const char* p)
+{
+    const char* s = p;
+    if (s[0] == '\\' && s[1] == '?' && s[2] == '?' &&
+        (s[3] == '\\' || s[3] == '/'))
+        s += 4;
+    if ((s[0] == 'U' || s[0] == 'u') && s[1] == ':' &&
+        (s[2] == '\\' || s[2] == '/'))
+        return s + 3;
+    for (; *s; s++)
+        if ((s == p || s[-1] == '\\' || s[-1] == '/') &&
+            udata_at(s) && (s[5] == '\\' || s[5] == '/'))
+            return s + 6;
+    return NULL;
+}
+
+int savelog_join(char* out, size_t outsz, const char* root_rel, const char* child)
+{
+    size_t r = strlen(root_rel);
+    while (r > 0 && (root_rel[r - 1] == '\\' || root_rel[r - 1] == '/'))
+        r--;
+    while (*child == '\\' || *child == '/')
+        child++;
+    size_t c = strlen(child);
+    if (outsz == 0 || r + 1 + c + 1 > outsz)
+        return -1;
+    memcpy(out, root_rel, r);
+    out[r] = '/';
+    memcpy(out + r + 1, child, c + 1);
+    return (int)(r + 1 + c);
+}
+
+int savelog_collapse(char* out, size_t outsz, const char* in)
+{
+    size_t o = 0;
+    const char* s;
+    for (s = in; *s; s++) {
+        int sep = (*s == '\\' || *s == '/');
+        if (o > 0 && sep && (out[o - 1] == '\\' || out[o - 1] == '/'))
+            continue;   /* a separator following a separator: drop it */
+        if (o + 1 >= outsz)
+            return -1;
+        out[o++] = sep ? '\\' : *s;   /* normalise to the log's backslash */
+    }
+    if (o >= outsz)
+        return -1;
+    out[o] = 0;
+    return (int)o;
+}
+
+const char* savelog_close_verb(unsigned writes, unsigned open_change)
+{
+    if (writes)
+        return "closed";
+    if (open_change == 1)
+        return "created";   /* the open created the file */
+    if (open_change == 2)
+        return "truncated"; /* the open truncated an existing file */
+    return NULL; /* no writes, open changed nothing: no line */
+}
+
+int savelog_line(char* out, size_t outsz, uint64_t tick_ms, const char* rel, const char* action)
+{
+    int n = snprintf(out, outsz, "[FCI] save @%llu: %s %s\n",
+                     (unsigned long long)tick_ms, rel, action);
+    return (size_t)n >= outsz ? -1 : n;
+}

