+++ b/src/kernel/savelog.h
@@ -0,0 +1,50 @@
+/*
+ * savelog.h - save log: the UDATA path filter and the line format (Q22b).
+ *
+ * Pure string logic, split out so a host test harness can compile and run
+ * savelog.c without the game. kernel_file.c calls these around the file
+ * operations that touch the save folder, one stderr line per event, so a
+ * log reader can compute the span of a save-point save.
+ */
+
+#ifndef XBOX_SAVELOG_H
+#define XBOX_SAVELOG_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The part of an Xbox path below its \UDATA\ segment (the save folder), or
+ * NULL if the path is not below UDATA. The segment match is case-insensitive
+ * and bounded by path separators. */
+const char* savelog_udata_rel(const char* xbox_path);
+
+/* root_rel + "/" + child, NUL-terminated, into out. Returns the length
+ * stored, or -1 if out is too small. */
+int savelog_join(char* out, size_t outsz, const char* root_rel, const char* child);
+
+/* A UDATA-relative path with runs of separators (\\, //, \/) collapsed to a
+ * single backslash, into out. The game builds some paths by appending a name
+ * to a folder path that already ends in a separator, which doubles it; the log
+ * shows one. Returns the length stored, or -1 if out is too small. */
+int savelog_collapse(char* out, size_t outsz, const char* in);
+
+/* The verb for the close line of a write-opened UDATA file: "closed",
+ * "created" (the open created the file) or "truncated" (the open truncated
+ * an existing file); NULL when a close with no writes of a file the open
+ * did not change prints no line. open_change: 0 none, 1 created, 2
+ * truncated. */
+const char* savelog_close_verb(unsigned writes, unsigned open_change);
+
+/* "[FCI] save @<tick_ms>: <rel> <action>\n" into out. Returns the length
+ * written, or -1 if out is too small. */
+int savelog_line(char* out, size_t outsz, uint64_t tick_ms, const char* rel, const char* action);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
