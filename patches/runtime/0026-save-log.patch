+/* ====================  Save log (Q22b)  ================================= */
+/*
+ * One stderr line per operation that changes a file below the save folder
+ * (\Device\Harddisk0\PartitionN\UDATA), so a log reader can compute the span
+ * of a save-point save (first write to last close). Read-only opens leave no
+ * line. Saves are rare, so this is always on.
+ */
+#include "savelog.h"
+
+#define SAVELOG_MAX 32
+typedef struct {
+    HANDLE     handle;
+    char       rel[MAX_PATH];
+    uint64_t   open_tick;
+    uint64_t   bytes;
+    unsigned   writes;
+    unsigned   open_change; /* 0 none, 1 the open created the file, 2 it
+                               truncated an existing one */
+    int        write;  /* opened for writing: a close leaves a line */
+    int        del;    /* delete requested: the close leaves no line */
+} SAVELOG_ENTRY;
+static SAVELOG_ENTRY s_savelog[SAVELOG_MAX];
+/* Race-free from first use: SRWLOCK_INIT is a real static init on Windows,
+ * and the POSIX compat's srw_lazy_init serialises its one-time allocation
+ * (win32_compat.c). A lazy InitializeCriticalSection races when two threads
+ * make the first file call. This is the toolkit's established pattern
+ * (guest_vmem.c, kernel_rtl.c). */
+static SRWLOCK s_savelog_lock = SRWLOCK_INIT;
+
+static void savelog_lock(void)
+{
+    AcquireSRWLockExclusive(&s_savelog_lock);
+}
+
+static SAVELOG_ENTRY* savelog_find(HANDLE h)
+{
+    int i;
+    for (i = 0; i < SAVELOG_MAX; i++)
+        if (s_savelog[i].handle == h)
+            return &s_savelog[i];
+    return NULL;
+}
+
+/* The UDATA-relative path of a path, or of a name relative to a tracked root
+ * directory, into out. Caller holds the lock. NULL if not under UDATA. */
+static char* savelog_resolve(const char* xbox_path, HANDLE root, char* out, size_t outsz)
+{
+    const char* rel;
+    char joined[MAX_PATH];
+    int i;
+    if (!xbox_path)
+        return NULL;
+    rel = (root == NULL || xbox_path[0] == '\\') ? savelog_udata_rel(xbox_path) : NULL;
+    if (rel) {
+        if (savelog_collapse(out, outsz, rel) >= 0)
+            return out;
+        return NULL;
+    }
+    if (root && xbox_path[0])
+        for (i = 0; i < SAVELOG_MAX; i++)
+            if (s_savelog[i].handle == root &&
+                savelog_join(joined, sizeof joined, s_savelog[i].rel, xbox_path) >= 0 &&
+                savelog_collapse(out, outsz, joined) >= 0)
+                return out;
+    return NULL;
+}
+
+static void savelog_emit(const char* rel, const char* action)
+{
+    char buf[512];
+    if (savelog_line(buf, sizeof buf, (uint64_t)GetTickCount64(), rel, action) >= 0) {
+        fprintf(stderr, "%s", buf);
+        fflush(stderr);
+    }
+}
+
+/* What the open itself did to the file: 0 nothing, 1 created it, 2
+ * truncated an existing one. The disposition and whether the file existed
+ * before the open tell: a successful open of an absent file created it, a
+ * truncating disposition on an existing file emptied it. */
+static unsigned savelog_open_change(int existed, ULONG disposition)
+{
+    if (!existed)
+        return 1;
+    if (disposition == XBOX_FILE_SUPERSEDE || disposition == XBOX_FILE_OVERWRITE ||
+        disposition == XBOX_FILE_OVERWRITE_IF)
+        return 2;
+    return 0;
+}
+
+/* Track a new open. write: the open may write, so its close leaves a line;
+ * directory opens are tracked with write = 0 so relative names resolve.
+ * open_change: what the open itself did to the file (savelog_open_change). */
+static void savelog_open(HANDLE h, const char* xbox_path, HANDLE root, int write,
+                         unsigned open_change)
+{
+    char rel[MAX_PATH];
+    int i;
+    savelog_lock();
+    if (savelog_resolve(xbox_path, root, rel, sizeof rel))
+        for (i = 0; i < SAVELOG_MAX; i++)
+            if (s_savelog[i].handle == NULL) {
+                s_savelog[i].handle = h;
+                snprintf(s_savelog[i].rel, sizeof s_savelog[i].rel, "%s", rel);
+                s_savelog[i].open_tick = (uint64_t)GetTickCount64();
+                s_savelog[i].bytes = 0;
+                s_savelog[i].writes = 0;
+                s_savelog[i].open_change = open_change;
+                s_savelog[i].write = write;
+                s_savelog[i].del = 0;
+                break;
+            }
+    ReleaseSRWLockExclusive(&s_savelog_lock);
+}
+
+static void savelog_write(HANDLE h, uint64_t n)
+{
+    SAVELOG_ENTRY* e;
+    savelog_lock();
+    e = savelog_find(h);
+    if (e) {
+        e->bytes += n;
+        e->writes++;
+    }
+    ReleaseSRWLockExclusive(&s_savelog_lock);
+}
+
+/* Not static: bridge_NtClose (kernel_bridge.c) closes the host handle
+ * itself and calls this for the line. */
+void savelog_close(HANDLE h)
+{
+    SAVELOG_ENTRY* e;
+    savelog_lock();
+    e = savelog_find(h);
+    if (e) {
+        if (e->write && !e->del) {
+            const char* verb = savelog_close_verb(e->writes, e->open_change);
+            if (verb) {
+                char action[96];
+                snprintf(action, sizeof action, "%s, %llu bytes in %u writes, open %llu ms",
+                         verb, (unsigned long long)e->bytes, e->writes,
+                         (unsigned long long)((uint64_t)GetTickCount64() - e->open_tick));
+                savelog_emit(e->rel, action);
+            }
+        }
+        e->handle = NULL;
+    }
+    ReleaseSRWLockExclusive(&s_savelog_lock);
+}
+
+/* One line for a tracked handle: a rename, a shrink, a delete on close. */
+static void savelog_event(HANDLE h, const char* action)
+{
+    SAVELOG_ENTRY* e;
+    savelog_lock();
+    e = savelog_find(h);
+    if (e)
+        savelog_emit(e->rel, action);
+    ReleaseSRWLockExclusive(&s_savelog_lock);
+}
+
+/* A delete that names the path itself (NtDeleteFile, possibly relative). */
+static void savelog_delete(const char* xbox_path, HANDLE root)
+{
+    char rel[MAX_PATH];
+    savelog_lock();
+    if (savelog_resolve(xbox_path, root, rel, sizeof rel))
+        savelog_emit(rel, "deleted");
+    ReleaseSRWLockExclusive(&s_savelog_lock);
+}
+
+/* Set-EOF to a smaller size, on a tracked handle. Caller holds the lock. */
+static void savelog_shrink_locked(SAVELOG_ENTRY* e, long long new_size)
+{
+    char action[48];
+    snprintf(action, sizeof action, "shrunk to %lld bytes", new_size);
+    savelog_emit(e->rel, action);
+}
