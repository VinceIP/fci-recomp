-/* FILE_RENAME_INFORMATION - NT layout. NtSetInformationFile does not
- * implement class 10, but the save log names a rename attempt with it
- * (kernel_file.c). */
+/* FILE_RENAME_INFORMATION, Xbox layout: the new name is an OBJECT_STRING,
+ * not NT's inline WCHAR array. The guest's is 16 bytes with 32-bit fields;
+ * bridge_NtSetInformationFile copies it into this native form. */
 typedef struct _XBOX_FILE_RENAME_INFORMATION {
-    BOOLEAN       ReplaceIfExists;
-    HANDLE        RootDirectory;
-    ULONG         FileNameLength;
-    CHAR          FileName[1];
+    BOOLEAN          ReplaceIfExists;
+    HANDLE           RootDirectory;
+    XBOX_ANSI_STRING FileName;
 } XBOX_FILE_RENAME_INFORMATION, *PXBOX_FILE_RENAME_INFORMATION;
 
