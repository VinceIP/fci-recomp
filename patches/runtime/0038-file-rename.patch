+/* A rename's destination; the source handle is open for DELETE only, so it is not tracked. */
+static void savelog_rename(const char* xbox_path, HANDLE root)
+{
+    char rel[MAX_PATH];
+    savelog_lock();
+    if (savelog_resolve(xbox_path, root, rel, sizeof rel))
+        savelog_emit(rel, "renamed into place");
+    ReleaseSRWLockExclusive(&s_savelog_lock);
+}
