--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -3659,9 +3659,35 @@ static void bridge_NtSetInformationFile(void)
         g_eax = 0xC0000005u;                 /* STATUS_ACCESS_VIOLATION */
         return;
     }
-    g_eax = (uint32_t)xbox_NtSetInformationFile(handle, &ios,
-                XBOX_TO_NATIVE(info_va), length,
-                (XBOX_FILE_INFORMATION_CLASS)infoclass);
+    if (infoclass == XboxFileRenameInformation) {
+        /* Guest layout: BOOLEAN, 32-bit RootDirectory, ANSI_STRING with a guest Buffer. */
+        XBOX_FILE_RENAME_INFORMATION ri;
+        static RECOMP_TLS char name[MAX_PATH];
+        uint16_t n = length >= 16 ? BRIDGE_MEM16(info_va + 8) : 0;
+        uint32_t buf_va = length >= 16 ? BRIDGE_MEM32(info_va + 12) : 0;
+        uint32_t root = length >= 16 ? BRIDGE_MEM32(info_va + 4) : 0;
+        if (!buf_va || !n || n >= sizeof name || !bridge_va_mapped(buf_va, n)) {
+            fprintf(stderr, "  [FILE] NtSetInformationFile rename: bad name (len %u, buffer %08X)\n",
+                    (unsigned)n, buf_va);
+            bridge_write_iostatus(ios_va, STATUS_INVALID_PARAMETER, 0);
+            g_eax = (uint32_t)STATUS_INVALID_PARAMETER;
+            return;
+        }
+        memcpy(name, XBOX_TO_NATIVE(buf_va), n);
+        name[n] = 0;
+        ri.ReplaceIfExists = BRIDGE_MEM8(info_va) != 0;
+        /* -3 is the XDK DOS-device namespace, not a file handle (as in bridge_build_oa). */
+        ri.RootDirectory = root && root != 0xFFFFFFFDu ? bridge_resolve_handle(root) : NULL;
+        ri.FileName.Buffer = name;
+        ri.FileName.Length = n;
+        ri.FileName.MaximumLength = (USHORT)(n + 1);
+        g_eax = (uint32_t)xbox_NtSetInformationFile(handle, &ios, &ri, sizeof ri,
+                    XboxFileRenameInformation);
+    } else {
+        g_eax = (uint32_t)xbox_NtSetInformationFile(handle, &ios,
+                    XBOX_TO_NATIVE(info_va), length,
+                    (XBOX_FILE_INFORMATION_CLASS)infoclass);
+    }
     bridge_write_iostatus(ios_va, ios.Status, (uint32_t)ios.Information);
 }
 
